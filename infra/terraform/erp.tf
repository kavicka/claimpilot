# The mock ERP (ADR-013, ADR-015): suppliers, orders and goods receipts for invoice matching, and
# the Peppol UBL intake the worker exports approved invoices to. It runs as the erp-mock service
# from the core-mock image (the same package, started with another command, as in
# docker-compose.yml), reachable inside as http://erp-mock:8000 and never from the load balancer.
#
# Its calls carry a bearer token. The token is its own secret, so the worker and the ERP see
# nothing else of the application secret's values than they need.

resource "random_password" "erp" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "erp_token" {
  #checkov:skip=CKV2_AWS_57:The token is generated by Terraform (state is encrypted with its own key); changing it is a taint and an apply, not a Lambda rotation.
  name                    = "${local.name}/erp-token"
  description             = "Bearer token of the mock ERP: erp-mock requires it, the worker sends it"
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "erp_token" {
  secret_id     = aws_secretsmanager_secret.erp_token.id
  secret_string = random_password.erp.result
}

# The execution role reads this one secret more; nothing is added to the existing statements.
resource "aws_iam_role_policy" "execution_erp_token" {
  name = "erp-token"
  role = aws_iam_role.execution.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "secretsmanager:GetSecretValue"
      Resource = aws_secretsmanager_secret.erp_token.arn
    }]
  })
}

locals {
  # ECS "secrets" entries (see secret_env in secrets.tf): the worker sends the token under the
  # name its settings read, the ERP expects it under the name it checks.
  erp_secret_env = {
    erp_token      = { name = "CLAIMPILOT_ERP_TOKEN", valueFrom = aws_secretsmanager_secret.erp_token.arn }
    erp_mock_token = { name = "ERP_MOCK_TOKEN", valueFrom = aws_secretsmanager_secret.erp_token.arn }
  }
}
