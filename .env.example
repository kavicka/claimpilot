# Copy to .env. All values are for local development.
CLAIMPILOT_DATABASE_URL=postgresql+psycopg://claimpilot:claimpilot@127.0.0.1:5438/claimpilot
CLAIMPILOT_REDIS_URL=redis://127.0.0.1:6389/0
CLAIMPILOT_OLLAMA_URL=http://127.0.0.1:11434
CLAIMPILOT_API_URL=http://127.0.0.1:4400
CLAIMPILOT_CORE_MOCK_URL=http://127.0.0.1:4401
# Generate with `make vault-key`
CLAIMPILOT_PII_VAULT_KEY=
# off | record | replay
CLAIMPILOT_LLM_CASSETTE_MODE=off
# Local Langfuse from infra/langfuse (make up-obs); keys are set by its headless init
CLAIMPILOT_LANGFUSE_HOST=http://127.0.0.1:4420
CLAIMPILOT_LANGFUSE_PUBLIC_KEY=pk-lf-claimpilot-local
CLAIMPILOT_LANGFUSE_SECRET_KEY=sk-lf-claimpilot-local
# Review UI login (local development only): users handler.demo and senior.demo are created on startup
# Left empty, no demo users are created. Session secret: any random string (`openssl rand -hex 32`)
CLAIMPILOT_DEMO_PASSWORD=claimpilot-demo
CLAIMPILOT_SESSION_SECRET=
# Uploads without a login (portal, `make seed`) send this in X-Intake-Token
CLAIMPILOT_INTAKE_TOKEN=change-me-local-only
# Shared secret between the api and the read-only MCP server (any random string locally)
CLAIMPILOT_MCP_TOKEN=change-me-local-only
# Bearer token for the mock ERP: erp_mock requires it on every call but /health, the worker sends it
# (`openssl rand -hex 16`). Left empty, the ERP is open.
CLAIMPILOT_ERP_TOKEN=change-me-local-only
