0":0.29089245673498887,"x1":0.17478178565195024,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":10,"kind":"text","text":"Bez značajnih prethodnih bolesti. Ne uzima stalnu terapiju.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.502695888290545,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":11,"kind":"section_header","text":"Status i terapija","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.2182263689525277,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":12,"kind":"text","text":"Pregled pokazao je oštećenje mišićno-koštanog sustava na desnom zglobu stopala s očiglednom oštećenost preponice. Nema znakova lomova, a rentgenski pregled nije pokazao lom. Izvršen je MRI, koji je potvrdio povredu ligamenta bez ozbiljnijih oštećenja kosti. Pacijentu je primijenjena terapija uključujući lekovite kompresije, lečenje hidroterapijom i preporuka za fizičku terapiju. Preporučeno je ograničavanje opterećenja zgloba i nadalje se pratiti oporavak.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.89316636123439,"y1":0.4615009778239803},"ocr":false},{"page":1,"seq":13,"kind":"text","text":"Liječnik: Nada Milovac Potpis i pečat","bbox":{"x0":0.086269841274241,"y0":0.5077899962161792,"x1":0.22141916269837447,"y1":0.5188596538821916},"ocr":false}],"parser":"docling","seconds":0.36}