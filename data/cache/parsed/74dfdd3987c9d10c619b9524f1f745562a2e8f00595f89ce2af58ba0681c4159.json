25202837338214745,"x1":0.5926831821666279,"y1":0.26586595193239565},"ocr":false},{"page":1,"seq":10,"kind":"section_header","text":"Anamneza","bbox":{"x0":0.086269841274241,"y0":0.29089245673498887,"x1":0.17478178565195024,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":11,"kind":"text","text":"Bez značajnih prethodnih bolesti. Ne uzima stalnu terapiju.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.502695888290545,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":12,"kind":"section_header","text":"Status i terapija","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.2182263689525277,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":13,"kind":"text","text":"Fizički pregled pokazao je povisenu temperaturu, pojačano disanje i plućne promjene na auskultaciji. Radi dijagnostičke potvrde provedeni su rendgenski snimci toraksa i laboratorijski pregled koji su potvrdili prisutnost infekcije. Lijecenje je započeto intravenoznim antibiotikom i paracetamolom za ublažavanje simptoma. Preporučeno je dovršavanje cijele terapije i ponovno pregledanje nakon 48 sati. Pacijentu je davano uputnica za nadzor u ambulantnoj klinici.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.9091027286879366,"y1":0.4615009778239803},"ocr":false},{"page":1,"seq":14,"kind":"text","text":"Liječnik: Jasminka Vižintin Potpis i pečat","bbox":{"x0":0.086269841274241,"y0":0.5077899962161792,"x1":0.24234012095318025,"y1":0.5188596538821916},"ocr":false}],"parser":"docling","seconds":0.38}