0743076263213547,"y1":0.364540453518271},"ocr":true},{"page":1,"seq":9,"kind":"text","text":"Pacient prezentoval horúčku, kašl'avost a dyspnoéiu. Priebežný lekársky vyšetrenie ukázalo zvýšené dýchanie, šmúrovanie a zvýšenú rezistenciu pri dýchaní. Radiologické vyšetrenie potvrdilo prítomnost infiltrátov v dolných častiach obidvoch plúc. Vykonané laboratórne testy ukázali zvýšenú hromadnost leukocytov a zvýšenú rýchlost sedimentácie erytrocytov. Pacientovi bol predpísaný antibiotikum z triedy makrolidov, antipyretikum a liečba kašl'avosti. Odporúča sa liečba doma so súčasným sledovaním stavu a opakovaným vyšetrením po 48 hodinách.","bbox":{"x0":0.08409610376337605,"y0":0.38341437210816265,"x1":0.8934448128532806,"y1":0.4671678736863038},"ocr":true},{"page":1,"seq":10,"kind":"text","text":"Lekár: MUDr. Tichomír Lubina","bbox":{"x0":0.0851923689707257,"y0":0.502852434132747,"x1":0.2661058350940906,"y1":0.5168479908552324},"ocr":true},{"page":1,"seq":11,"kind":"text","text":"Podpis, pečiatka","bbox":{"x0":0.4658342378271283,"y0":0.5089587622757632,"x1":0.5688333069844865,"y1":0.5202267400562024},"ocr":true},{"page":1,"seq":12,"kind":"section_header","text":"PRIJATÉ","bbox":{"x0":0.6225145082537493,"y0":0.06911932007621699,"x1":0.7839416023421261,"y1":0.1179754710049257},"ocr":true},{"page":1,"seq":13,"kind":"text","text":"Lekárska správa","bbox":{"x0":0.824112089380037,"y0":0.07486526255476812,"x1":0.9254696161945393,"y1":0.08574725253089911},"ocr":true}],"parser":"docling","seconds":1.8}