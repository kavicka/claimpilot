{"sha256":"480a9468c5546470cdf8896f8ee9c7c0c4706babaafc415bd161c3ca6d8aaf55","mime_type":"application/pdf","pages":[{"page":1,"width":595.44,"height":842.04,"text_chars":0}],"blocks":[{"page":1,"seq":0,"kind":"section_header","text":"Ambulancia všeobecného lekára Martinecová Kolbasov, Slovenská republika","bbox":{"x0":0.1135296272621687,"y0":0.055845703792377084,"x1":0.625836476203727,"y1":0.091706829041262},"ocr":true},{"page":1,"seq":1,"kind":"text","text":"Lekárska správa","bbox":{"x0":0.8422505861217484,"y0":0.08233971476908306,"x1":0.9423068801811003,"y1":0.09461149916570717},"ocr":true},{"page":1,"seq":2,"kind":"section_header","text":"Lekárska správa","bbox":{"x0":0.10927933474797587,"y0":0.1093323568442402,"x1":0.3152858001283563,"y1":0.13577301766181502},"ocr":true},{"page":1,"seq":3,"kind":"text","text":"PACIENT","bbox":{"x0":0.11813961004816509,"y0":0.15123487230268576,"x1":0.17478916710142045,"y1":0.160666098643819},"ocr":true},{"page":1,"seq":4,"kind":"text","text":"Alexej Máčik","bbox":{"x0":0.11815899020797042,"y0":0.1634007031375753,"x1":0.2155822223238086,"y1":0.17736986110221145},"ocr":true},{"page":1,"seq":5,"kind":"text","text":"DÁTUM VYSETRENIA","bbox":{"x0":0.11505797578199226,"y0":0.18794611432624345,"x1":0.24772931643667967,"y1":0.20279126699295905},"ocr":true},{"page":1,"seq":6,"kind":"text","text":"11.7.2026","bbox":{"x0":0.11482503888116066,"y0":0.20226472539663481,"x1":0.20153798180795113,"y1":0.21803691419163973},"ocr":true},{"page":1,"seq":7,"kind":"text","text":"DIAGNÓZA","bbox":{"x0":0.11289287088289945,"y0":0.22765883087086575,"x1":0.1813524387041351,"y1":0.23883415709156466},"ocr":true},{"page":1,"seq":8,"kind":"text","text":"Lumbálna diskopatia L4/L5 s koreňovým dráždením","bbox":{"x0":0.11210197139957163,"y0":0.23997564861196385,"x1":0.5032650847699539,"y1":0.26647597051435273},"ocr":true},{"page":1,"seq":9,"kind":"section_header","text":"Anamnéza","bbox":{"x0":0.09946218549301143,"y0":0.27994906951902665,"x1":0.1909386823000601,"y1":0.29297287080558704},"ocr":true},{"page":1,"seq":10,"kind":"text","text":"Pacient je dispenzarizovaný pre diskopatiu L4/L5 od marca 2025, opakovane liečený pre bolesti chrbta.","bbox":{"x0":0.09639395938557739,"y0":0.3109322385368044,"x1":0.8363790794797165,"y1":0.35004538461847673},"ocr":true},{"page":1,"seq":11,"kind":"section_header","text":"Nález a liečba","bbox":{"x0":0.09500065688808462,"y0":0.3423144538300501,"x1":0.21511973183380048,"y1":0.35971909391509016},"ocr":true},{"page":1,"seq":12,"kind":"text","text":"Pozorovanie: Pacient prezentoval bolest v spodnej časti chrbta, radikulárnu bolest po pravej strane, zhoršenú pri pohybe. Pri fyzikálnom vyšetrení bola pozorovaná znižená sily v svalu pohybovom šlape, pozitivne známky Lasegueho a Slump testu. Nepritomnost neurologických deficitov. Diagnostické vyšetrenie MRI lumbosakrálnych segmentov ukázalo degeneratívne zmeny disku L4/L5 so stlačenim žilných štruktúr. Uvedené nálezy potvrzujú diagnostiku. Zákroky: konzervatívna liečba s ciel'om zniżit zátaž na disky, účinná analgetika, fyzikálna terapia a zavedenie postihnutých svalov. Odporúča sa opakovanie vyšetrenia po 6 týždňoch a v prípade nedostatočného výsledku zvážit dalšie opcie.","bbox":{"x0":0.08454022483266461,"y0":0.3754351327957355,"x1":0.8955905519903445,"y1":0.49111336092138785},"ocr":true},{"page":1,"seq":13,"kind":"text","text":"Lekár: MUDr. Xénia Zachariašová","bbox":{"x0":0.08208202974803078,"y0":0.5258209562693051,"x1":0.2845333216487243,"y1":0.542106778862527},"ocr":true},{"page":1,"seq":14,"kind":"text","text":"Podpis, pečiatka NAR.","bbox":{"x0":0.4630234632618893,"y0":0.5384386611917332,"x1":0.5658456819125885,"y1":0.552010056191106},"ocr":true},{"page":1,"seq":15,"kind":"text","text":"23. 2. 1969","bbox":{"x0":0.5709990558794136,"y0":0.17814270438796984,"x1":0.6592992094477919,"y1":0.19149745344975272},"ocr":true},{"page":1,"seq":16,"kind":"section_header","text":"DORUČENÉ","bbox":{"x0":0.6094250249273103,"y0":0.13571097376045085,"x1":0.