02837338214745,"x1":0.5948501927807082,"y1":0.26586595193239565},"ocr":false},{"page":1,"seq":10,"kind":"section_header","text":"Anamneza","bbox":{"x0":0.086269841274241,"y0":0.29089245673498887,"x1":0.17478178565195024,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":11,"kind":"text","text":"Bez značajnih prethodnih bolesti. Ne uzima stalnu terapiju.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.502695888290545,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":12,"kind":"section_header","text":"Status i terapija","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.2182263689525277,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":13,"kind":"text","text":"Pacijent prikazuje znakove konusije, uključujući kratkotrajnu gubitku svijesti i disocijaciju. Neurološki pregled nije pokazao znakove ozbiljnijih ozljeda. MRI glave nije pokazao frakture, krvarenja ili druge strukturne promjene. Pacijentu je propisan repozicija i praćenje simptoma tijekom sljedećih 24 sata. Preporučeno je izbjegavanje fizičke aktivnosti i intenzivnog mentalnog napora te obrazovanje o znakovima koje zahtijevaju hitnu medicinsku pomoć.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.8957725981918727,"y1":0.44626739196938375},"ocr":false},{"page":1,"seq":14,"kind":"text","text":"Liječnik: Suzana Ćorić","bbox":{"x0":0.086269841274241,"y0":0.4925564103615826,"x1":0.2194034126522752,"y1":0.5036260680275951},"ocr":false},{"page":1,"seq":15,"kind":"text","text":"Potpis i pečat","bbox":{"x0":0.4672222222866182,"y0":0.4925564103615826,"x1":0.5498545358430462,"y1":0.5036260680275951},"ocr":false}],"parser":"docling","seconds":0.35}