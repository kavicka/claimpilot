673498887,"x1":0.17478178565195024,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":10,"kind":"text","text":"Bez významných předchozích onemocnění. Trvalou medikaci neužívá.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.5830948222044029,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":11,"kind":"section_header","text":"Nález a léčba","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.19892942452263254,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":12,"kind":"text","text":"Pacient při vyšetření prezentoval mírnou závratě, zhoršenou koncentraci a narušenou koordinaci. Neurologické vyšetření bylo v zásadě normální, žádné známky focálního poruchy. Výsledky neuroobrazového vyšetření nepotvrdily zlomeniny ani jiné strukturální změny. Pacient byl hospitalizován na dohled a doporučeno bylo odpočívat a omezit fyzickou i mentální zátěž. Doporučeno je sledovat stav pacienta a opakovat vyšetření po 24 hodinách.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.9132031011400736,"y1":0.44626739196938375},"ocr":false},{"page":1,"seq":13,"kind":"text","text":"Lékař: Mária Němcová","bbox":{"x0":0.086269841274241,"y0":0.4925564103615826,"x1":0.22167449103754702,"y1":0.5036260680275951},"ocr":false},{"page":1,"seq":14,"kind":"text","text":"Podpis, razítko","bbox":{"x0":0.4672222222866182,"y0":0.4925564103615826,"x1":0.5568021543352684,"y1":0.5036260680275951},"ocr":false}],"parser":"docling","seconds":0.53}
