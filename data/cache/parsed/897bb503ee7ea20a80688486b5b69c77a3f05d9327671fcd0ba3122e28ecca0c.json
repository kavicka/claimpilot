9841274241,"y0":0.29089245673498887,"x1":0.17509928565171085,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":10,"kind":"text","text":"Keine relevanten Vorerkrankungen. Keine Dauermedikation.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.5086919319709572,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":11,"kind":"section_header","text":"Befund und Therapie","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.26168859114198084,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":12,"kind":"text","text":"Bei der klinischen Untersuchung zeigte sich eine schmerzhafte, geschwollene Verletzung im Bereich des distalen Radius mit eingeschränkter Beweglichkeit. Die Röntgenaufnahmen bestätigten eine Fraktur des distalen Radius. Es wurden keine Komplikationen wie Nerven- oder Gefäßschäden festgestellt. Die Patientin erhielt eine konservative Behandlung mit Gipsfixation im neutralen Verband. Eine nachfolgende Kontrolle nach vier Wochen ist empfohlen.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.9053231684582876,"y1":0.44626739196938375},"ocr":false},{"page":1,"seq":13,"kind":"text","text":"Behandelnde/r Ärztin/Arzt: Leopold Forster Unterschrift, Stempel","bbox":{"x0":0.086269841274241,"y0":0.4925564103615826,"x1":0.34381550549752005,"y1":0.5036260680275951},"ocr":false}],"parser":"docling","seconds":0.33}
