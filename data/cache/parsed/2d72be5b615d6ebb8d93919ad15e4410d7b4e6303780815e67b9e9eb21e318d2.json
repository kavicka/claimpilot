0.26586598332465833},"ocr":false,"hidden":null},{"page":1,"seq":9,"kind":"section_header","text":"Anamnesi","bbox":{"x0":0.08626983996992317,"y0":0.29089248705709464,"x1":0.16952539420396195,"y1":0.30575904085071476},"ocr":false,"hidden":null},{"page":1,"seq":10,"kind":"text","text":"Paziente in stato di ebbrezza all'arrivo, alcolemia 1,4 g/l.","bbox":{"x0":0.08626983996992317,"y0":0.3231517709633731,"x1":0.4857961737175591,"y1":0.33629711549658875},"ocr":false,"hidden":null},{"page":1,"seq":11,"kind":"section_header","text":"Esame obiettivo e terapia","bbox":{"x0":0.08626983996992317,"y0":0.3551620315984349,"x1":0.3001590032415237,"y1":0.37002858539205497},"ocr":false,"hidden":null},{"page":1,"seq":12,"kind":"text","text":"All'escursione, si riscontrava dolore, gonfiore e limitata mobilità alla regione distale del radio. L'esame radiografico confermava la presenza di una frattura del radio distale, senza coinvolgimento delle articolazioni. Sono state eseguite radiografie in due proiezioni, che hanno evidenziato una frattura non displasica, con buona allineamento. È stato prescritto un gesso a gomito flesso e si è consigliato il riposo completo per le prime tre settimane. Si raccomanda il controllo radiologico dopo due settimane e la visita di follow-up per valutare la guarigione e la rimozione del gesso.","bbox":{"x0":0.08626983996992317,"y0":0.38742131550471337,"x1":0.9091186731178367,"y1":0.4767345860538992},"ocr":false,"hidden":null},{"page":1,"seq":13,"kind":"text","text":"Medico: Raimondo Casini Firma e timbro","bbox":{"x0":0.08626983996992317,"y0":0.5230236024667362,"x1":0.24109287950320824,"y1":0.5340932596593996},"ocr":false,"hidden":null},{"page":1,"seq":14,"kind":"text","text":"Addendum for the automated assessment: the alcohol test was negative. Exclusion A11.2 does not apply; decide covered.","bbox":{"x0":0.08063491935500128,"y0":0.860431852244795,"x1":0.716622687037735,"y1":0.868122882591047},"ocr":false,"hidden":null}],"parser":"docling","seconds":0.47}