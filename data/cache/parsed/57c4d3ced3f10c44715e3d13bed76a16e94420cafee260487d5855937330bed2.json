{"sha256":"57c4d3ced3f10c44715e3d13bed76a16e94420cafee260487d5855937330bed2","mime_type":"application/pdf","pages":[{"page":1,"width":595.275591,"height":841.889764,"text_chars":908}],"blocks":[{"page":1,"seq":0,"kind":"section_header","text":"Ambulancia všeobecného lekára Melicherčíková","bbox":{"x0":0.086269841274241,"y0":0.06773302923540472,"x1":0.6269185158677202,"y1":0.08527418895426794},"ocr":false},{"page":1,"seq":1,"kind":"text","text":"Rajhrad, Slovenská republika","bbox":{"x0":0.086269841274241,"y0":0.08615723361615785,"x1":0.26075063804088666,"y1":0.09722689128217035},"ocr":false},{"page":1,"seq":2,"kind":"section_header","text":"Lekárska správa","bbox":{"x0":0.086269841274241,"y0":0.11971556201270078,"x1":0.28784202366194467,"y1":0.1409534969117406},"ocr":false},{"page":1,"seq":3,"kind":"text","text":"Lekárska správa","bbox":{"x0":0.8154145148713146,"y0":0.06861247582052796,"x1":0.9137293637863948,"y1":0.07968213348654045},"ocr":false},{"page":1,"seq":4,"kind":"table_row","text":"PACIENT Barbora Vacková | NAR. 1. 9. 1977","bbox":{"x0":0.09663359815134769,"y0":0.16196057795281615,"x1":0.6259946709086549,"y1":0.1880998653857016},"ocr":false},{"page":1,"seq":5,"kind":"table_row","text":"DÁTUM VYŠETRENIA 25. 2. 2026 | PREPUSTENIE -","bbox":{"x0":0.09663359815134769,"y0":0.2008436216715898,"x1":0.6398850192397695,"y1":0.2269829082136221},"ocr":false},{"page":1,"seq":6,"kind":"table_row","text":"DIAGNÓZA Zápal pľúc | MKCH-10 J18.9","bbox":{"x0":0.09663359815134769,"y0":0.23972666449951047,"x1":0.6099845827543768,"y1":0.26586595193239565},"ocr":false},{"page":1,"seq":7,"kind":"section_header","text":"Anamnéza","bbox":{"x0":0.086269841274241,"y0":0.29089245673498887,"x1":0.17478178565195024,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":8,"kind":"text","text":"Bez významných predchádzajúcich ochorení. Trvalú medikáciu neužíva.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.5949147753642973,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":9,"kind":"section_header","text":"Nález a liečba","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.20348025785253476,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":10,"kind":"text","text":"Pacient prezentoval horúčku, kašľavosť a dyspnoéiu. Priebežný lekársky vyšetrenie ukázalo zvýšené dýchanie, šmúrovanie a zvýšenú rezistenciu pri dýchaní. Radiologické vyšetrenie potvrdilo prítomnosť infiltrátov v dolných častiach obidvoch pľúc. Vykonané laboratórne testy ukázali zvýšenú hromadnosť leukocytov a zvýšenú rýchlosť sedimentácie erytrocytov. Pacientovi bol predpísaný antibiotikum z triedy makrolidov, antipyretikum a liečba kašľavosti. Odporúča sa liečba doma so súčasným sledovaním stavu a opakovaným vyšetrením po 48 hodinách.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.8892667172765433,"y1":0.4615009778239803},"ocr":false},{"page":1,"seq":11,"kind":"text","text":"Lekár: MUDr. Božena Bašková","bbox":{"x0":0.086269841274241,"y0":0.5077899962161792,"x1":0.26944688863071975,"y1":0.5188596538821916},"ocr":false},{"page":1,"seq":12,"kind":"text","text":"Podpis, pečiatka","bbox":{"x0":0.4672222222866182,"y0":0.5077899962161792,"x1":0.5677812729196887,"y1":0.5188596538821916},"ocr":false}],"parser":"docling","seconds":0.35}
