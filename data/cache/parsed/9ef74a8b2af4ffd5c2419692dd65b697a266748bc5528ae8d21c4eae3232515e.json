34769,"y0":0.25202837338214745,"x1":0.5926831821666279,"y1":0.26586595193239565},"ocr":false},{"page":1,"seq":10,"kind":"section_header","text":"Anamneza","bbox":{"x0":0.086269841274241,"y0":0.29089245673498887,"x1":0.17478178565195024,"y1":0.3057590111643168},"ocr":false},{"page":1,"seq":11,"kind":"text","text":"Bez značajnih prethodnih bolesti. Ne uzima stalnu terapiju.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.502695888290545,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":12,"kind":"section_header","text":"Status i terapija","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.2182263689525277,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":13,"kind":"text","text":"Pregledom uočena je hronična bolest disajnih putova s naglaskom na bronhitisu. Povraćajni sindrom i suženje bronha. Uzorci izdaha pokazali su prisutnost leukocita i eozinocita. Uzeta su zračenja i analize krvi. Poboljšanje uočeno je nakon terapije s antiinflamatorima i bronhodilatatorima. Preporučeno je nadaljevodno praćenje i izbjegavanje agresivnih faktora okoliša.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.8740720075398628,"y1":0.44626739196938375},"ocr":false},{"page":1,"seq":14,"kind":"text","text":"Liječnik: Mislav Lukša Potpis i pečat","bbox":{"x0":0.086269841274241,"y0":0.4925564103615826,"x1":0.2169576359296748,"y1":0.5036260680275951},"ocr":false}],"parser":"docling","seconds":0.36}