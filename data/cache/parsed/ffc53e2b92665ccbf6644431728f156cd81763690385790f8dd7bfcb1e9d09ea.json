.5216378382966992,"y1":0.3385646553308695},"ocr":true},{"page":1,"seq":10,"kind":"section_header","text":"Befund und Therapie","bbox":{"x0":0.09510137663455326,"y0":0.3401942432268826,"x1":0.2739937719983602,"y1":0.3630634420343938},"ocr":true},{"page":1,"seq":11,"kind":"text","text":"Bei der klinischen Untersuchung zeigten sich keine neurologischen Auffälligkeiten, jedoch eine vorübergehende Verwirrtheit und ein kurzer Gedächtnisverlust. Die Kopf- und Halsuntersuchung ergaben keine Verletzungen. Die durchgeführte Bildgebung (CT des Schädels) zeigte keine Frakturen oder intrakranielle Blutungen. Der Patient erhielt eine ambulante Nachbeobachtung sowie medikamentöse Unterstützung zur Linderung von Kopfschmerzen. Es wurde eine vorübergehende Arbeitsunfähigkeit empfohlen und eine Rückkehr zur ambulanten Nachsorge in 48 Stunden.","bbox":{"x0":0.0859034544929218,"y0":0.3745622154949533,"x1":0.9174580645854615,"y1":0.4758699690914619},"ocr":true},{"page":1,"seq":12,"kind":"text","text":"Behandelnde/r Ärztin/Arzt: Linnea Staudinger Unterschrift, Stempel GEB.","bbox":{"x0":0.08351201445847929,"y0":0.5078280217970084,"x1":0.35754054833118226,"y1":0.5305784080749039},"ocr":true},{"page":1,"seq":13,"kind":"section_header","text":"PRIJATÉ","bbox":{"x0":0.6121388875657177,"y0":0.13015363422723944,"x1":0.7587220539690736,"y1":0.16203564677708168},"ocr":true},{"page":1,"seq":14,"kind":"text","text":"27.02.1956","bbox":{"x0":0.5706006024114205,"y0":0.1775249085477878,"x1":0.6584845980557105,"y1":0.19154195138158295},"ocr":true},{"page":1,"seq":15,"kind":"text","text":"ENTLASSUNG","bbox":{"x0":0.5687237106420998,"y0":0.20394161605272904,"x1":0.6589980569342094,"y1":0.2168073579439751},"ocr":true},{"page":1,"seq":16,"kind":"text","text":"-","bbox":{"x0":0.5679978534971103,"y0":0.21834103961547668,"x1":0.5902868868682473,"y1":0.22760339830380463},"ocr":true},{"page":1,"seq":17,"kind":"text","text":"ICD-10","bbox":{"x0":0.5653756138530179,"y0":0.24242317255489804,"x1":0.612575922075638