ar medication.","bbox":{"x0":0.086269841274241,"y0":0.32315174202070474,"x1":0.4684286323143941,"y1":0.3362970871160277},"ocr":false},{"page":1,"seq":10,"kind":"section_header","text":"Findings and treatment","bbox":{"x0":0.086269841274241,"y0":0.3551620040245554,"x1":0.28094647803222283,"y1":0.3700285584538834},"ocr":false},{"page":1,"seq":11,"kind":"text","text":"Right ear examination revealed mild erythema and bulging of the tympanic membrane with limited mobility. No purulent discharge observed. Pure tone audiometry showed mild conductive hearing loss in the right ear. No signs of complications such as mastoid tenderness or facial nerve involvement. Treatment included a course of oral amoxicillin-clavulanate and analgesic therapy. Patient advised to return for re-evaluation in 48 hours if symptoms persist or worsen.","bbox":{"x0":0.086269841274241,"y0":0.3874212893102713,"x1":0.8977828729855823,"y1":0.4615009778239803},"ocr":false},{"page":1,"seq":12,"kind":"text","text":"Attending physician: Ian Whitehouse Signature and stamp","bbox":{"x0":0.086269841274241,"y0":0.5077899962161792,"x1":0.3050727896114928,"y1":0.5188596538821916},"ocr":false}],"parser":"docling","seconds":0.35}