<!doctype html>
<html lang="{{ lang }}"><head><meta charset="utf-8"><style>
@page { size: A4; margin: {% block margin %}14mm 12mm 16mm 12mm{% endblock %};
  @bottom-right { content: {% block pagecounter %}"strana " counter(page) " z " counter(pages){% endblock %}; font: 7.5pt Arial, sans-serif; color: #444; }
  @bottom-left { content: "{% block footnote %}{% endblock %}"; font: 6.5pt Arial, sans-serif; color: #666; } }
* { box-sizing: border-box; }
body { font: 8.4pt/1.3 Arial, "Helvetica Neue", sans-serif; color: #111; margin: 0; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; vertical-align: top; padding: .7mm 1.2mm; }
th { font-size: 7.4pt; font-weight: 600; color: #222; }
.num { text-align: right; white-space: nowrap; }
.b { font-weight: 700; }
.muted { color: #555; font-size: 7.2pt; }
.small { font-size: 7.2pt; }
.box { border: .5pt solid #444; padding: 1.5mm 2mm; }
.two { display: flex; gap: 4mm; justify-content: space-between; }
.two > div { flex: 1; }
.pb { page-break-before: always; }
.nobreak { page-break-inside: avoid; }
{% block style %}{% endblock %}
</style></head>
<body>{% block body %}{% endblock %}</body></html>
